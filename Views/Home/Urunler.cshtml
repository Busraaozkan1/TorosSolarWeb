@model IEnumerable<TorosSolar.Models.Product>

<section class="section-padding bg-darker">
    <div class="container">
        <h2 class="section-title text-center mb-5">Ürün Kataloğumuz</h2>
        
        @if (!Model.Any())
        {
            <div class="alert alert-info bg-dark text-light border-secondary text-center">
                Henüz ürün eklenmemiş. Lütfen daha sonra tekrar kontrol edin.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="product-card h-100 d-flex flex-column position-relative">
                            
                            @* --- SADECE GİRİŞ YAPANLAR İÇİN FAVORİ BUTONU --- *@
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <button class="btn border-0 position-absolute top-0 end-0 m-2 p-0 favorite-btn" 
                                        onclick="toggleFavorite(@item.Id, this)"
                                        style="z-index: 10; background: none;" 
                                        title="Favorilere Ekle">
                                    <i class="bi bi-heart text-danger fs-4 shadow-sm"></i>
                                </button>
                            }

                            <div style="background: rgba(255,255,255,0.05); padding: 10px;">
                                <img src="@item.ImageUrl" class="img-fluid" alt="@item.Name" 
                                     style="height: 200px; width: 100%; object-fit: contain;">
                            </div>
                            
                            <div class="product-info flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 style="color: #333; font-weight: bold;">@item.Name</h5>
                                    <h4 class="text-gold">$@item.Price.ToString("N0")</h4>
                                </div>
                                
                                <button class="btn btn-outline-light btn-sm mt-3 w-100" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modal-@item.Id">
                                    Detaylı İncele <i class="bi bi-search ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    @* MODAL KISMI *@
                    <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-gold-thin">
                                <div class="modal-header border-secondary">
                                    <h5 class="modal-title">@item.Name</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-4 text-start">
                                    <div class="text-center mb-3" style="background: #1a1a1a; border-radius: 8px;">
                                        <img src="@item.ImageUrl" class="img-fluid rounded" 
                                             style="max-height: 300px; object-fit: contain;">
                                    </div>
                                    
                                    <div class="text-secondary mb-3">
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            @Html.Raw(item.Description.Replace("\n", "<br>").Replace("\r", ""))
                                        }
                                    </div>
                                    
                                    <hr class="border-secondary">
                                    <h3 class="text-gold text-end">$@item.Price.ToString("N0")</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* Layout'taki Scripts bölümüne gönderiyoruz, çakışmayı bu engeller *@
@section Scripts {
<script>
function toggleFavorite(productId, button) {
    const $icon = $(button).find('i');
    
    $.ajax({
        url: '@Url.Action("ToggleFavorite", "Account")', 
        type: 'POST',
        data: { productId: productId },
        success: function (response) {
            if (response.success) {
                if (response.action === "added") {
                    $icon.removeClass('bi-heart').addClass('bi-heart-fill');
                } else {
                    $icon.removeClass('bi-heart-fill').addClass('bi-heart');
                }
            } else {
                alert(response.message);
            }
        },
        error: function (xhr) {
            console.error("Hata Detayı: ", xhr.responseText);
            alert("Sistem şu an bu isteğe cevap veremiyor. Kod: " + xhr.status);
        }
    });
}
</script>
}