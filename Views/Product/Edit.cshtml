@model TorosSolar.Models.Product
@{
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-warning text-dark p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Ürünü Düzenle</h5>
                        <a href="/Product/Index" class="btn btn-outline-dark btn-sm">Listeye Dön</a>
                    </div>
                </div>
                <div class="card-body p-4 bg-white">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" /> <div class="row">
                            <div class="col-md-7 mb-3">
                                <label class="form-label fw-bold">Ürün Adı</label>
                                <input asp-for="Name" class="form-control" required />
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label fw-bold">Fiyat (₺)</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">Mevcut Görsel</label>
                                <div class="mb-2">
                                    <img src="@Model.ImageUrl" width="100" class="rounded shadow-sm border" />
                                </div>
                                <label class="form-label fw-bold">Yeni Görsel (Değiştirmek istemiyorsanız boş bırakın)</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-md-12 mb-4">
                                <label class="form-label fw-bold">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow">
                                <i class="fas fa-sync me-2"></i>Değişiklikleri Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>