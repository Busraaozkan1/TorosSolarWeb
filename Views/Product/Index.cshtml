@model IEnumerable<TorosSolar.Models.Product>
@{
    Layout = "_AdminLayout"; // Kendi yaptığımız şık şablonu kullanıyoruz
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-boxes text-primary"></i> Ürün Yönetimi</h2>
    <a href="/Product/Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Yeni Ürün Ekle
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Görsel</th>
                <th>Ürün Adı</th>
                <th>Fiyat</th>
                <th>Ekleme Tarihi</th>
                <th class="text-center">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" width="50" class="rounded shadow-sm" />
                        }
                        else
                        {
                            <span class="badge bg-secondary">Resim Yok</span>
                        }
                    </td>
                    <td class="fw-bold">@item.Name</td>
                    <td class="text-success fw-bold">@item.Price.ToString("C2")</td>
                    <td>@item.CreatedDate.ToShortDateString()</td>
                    <td class="text-center">
                        <a href="/Product/Edit/@item.Id" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="/Product/Delete/@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>