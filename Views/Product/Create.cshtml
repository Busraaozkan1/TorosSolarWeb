@model TorosSolar.Models.Product
@{
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Yeni Ürün Ekle</h5>
                        <a href="/Product/Index" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-list me-1"></i>Listeye Dön
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-7 mb-3">
                                <label class="form-label fw-bold">Ürün Adı</label>
                                <input asp-for="Name" class="form-control form-control-lg shadow-sm" placeholder="Örn: 450W Mono Perc Panel" required />
                            </div>

                            <div class="col-md-5 mb-3">
                                <label class="form-label fw-bold">Fiyat (₺)</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-light">₺</span>
                                    <input asp-for="Price" class="form-control form-control-lg" type="number" step="0.01" required />
                                </div>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">Ürün Görseli</label>
                                <div class="input-group shadow-sm">
                                    <input type="file" name="imageFile" class="form-control" accept="image/*" id="imageInput" />
                                    <label class="input-group-text" for="imageInput"><i class="fas fa-upload"></i></label>
                                </div>
                                <small class="text-muted">Lütfen yüksek çözünürlüklü bir fotoğraf seçin.</small>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label class="form-label fw-bold">Detaylı Bilgi / Açıklama</label>
                                <textarea asp-for="Description" class="form-control shadow-sm" rows="5" placeholder="Ürün teknik özelliklerini buraya yazın..."></textarea>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg shadow">
                                <i class="fas fa-save me-2"></i>Ürünü Sisteme Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>