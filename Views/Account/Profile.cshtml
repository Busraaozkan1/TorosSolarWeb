@model IEnumerable<TorosSolar.Models.Product>
@{
    ViewData["Title"] = "Profilim";
}

<div class="container mt-5 pt-5">
    <div class="card bg-dark text-white p-4" style="border: 1px solid #d4af37; border-radius: 15px;">
        <div class="d-flex align-items-center mb-4">
            <h2 class="mb-0">Hoş Geldin, <span class="text-gold" style="color:#d4af37">@ViewBag.UserName</span>!</h2>
        </div>
        
        <hr class="border-secondary">
        
        <div class="row mt-4">
            <div class="col-md-12">
                <h5>Profil Bilgilerin</h5>
                <p class="text-secondary mt-3">Buradan favori ürünlerini ve sipariş taleplerini takip edebilirsin.</p>
                
                <h5 class="mt-5 mb-4" style="color:#d4af37"><i class="bi bi-heart-fill"></i> Favori Ürünlerim</h5>
                
                <div class="row">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <div class="col-md-4 mb-4">
                                <div class="card bg-dark text-white h-100" style="border: 1px solid #444; border-radius: 10px; overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        @* Görselin sığması için contain ve beyaz arka plan eklendi *@
                                        <div style="background-color: white; padding: 10px;">
                                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 180px; object-fit: contain;">
                                        </div>
                                    }
                                    <div class="card-body d-flex flex-column">
                                        <h6 class="card-title" style="font-size: 0.9rem;">@item.Name</h6>
                                        <div class="mt-auto pt-3 d-flex justify-content-between align-items-center">
                                            @* Birim dolar ($) olarak güncellendi *@
                                            <span class="fw-bold" style="color:#d4af37">@item.Price.ToString("N2") $</span>
                                            <a href="/Product/Details/@item.Id" class="btn btn-sm btn-outline-warning">İncele</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-4" style="border: 1px dashed #444; border-radius: 10px;">
                            <p class="text-secondary mb-0">Henüz favori ürününüz bulunmuyor.</p>
                            @* Yönlendirme hatası düzeltildi: /Product/Index -> /Home/Urunler *@
                            <a href="/Home/Urunler" class="text-gold small" style="color:#d4af37; text-decoration:none;">Ürünlere göz atmak ister misin?</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mt-5 border-top pt-3">
            <a href="/" class="btn btn-outline-light me-2">Ana Sayfaya Dön</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                 <button type="submit" class="btn btn-danger">Çıkış Yap</button>
            </form>
        </div>
    </div>
</div>