@{
    Layout = "_AdminLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    @* Başlığı içeriğe uygun olarak güncelledik *@
                    <h5 class="mb-0"><i class="fas fa-user-cog me-2"></i>Hesap Ayarları</h5>
                </div>
                <div class="card-body p-4">
                    <h4 class="mb-4 text-center">Giriş Bilgilerini Güncelle</h4>
                    
                    @* Hata mesajlarını göstermek için *@
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken() @* Güvenlik katmanı *@

                        @* 1. KULLANICI ADI ALANI (Yeni eklendi) *@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Kullanıcı Adı</label>
                            @* Value kısmına @User.Identity.Name yazarak mevcut kullanıcı adını kutuya otomatik getirdik *@
                            <input type="text" name="newUsername" class="form-control" value="@(User.Identity?.Name ?? "")" required />
                            <small class="text-muted">Giriş yaparken kullandığınız isminizi buradan değiştirebilirsiniz.</small>
                        </div>

                        <hr />

                        @* 2. MEVCUT ŞİFRE *@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mevcut Şifre</label>
                            <input type="password" name="currentPassword" class="form-control" placeholder="Eski şifreniz" required />
                        </div>

                        @* 3. YENİ ŞİFRE *@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Şifre</label>
                            <input type="password" name="newPassword" class="form-control" placeholder="Yeni şifreniz" required />
                        </div>

                        @* 4. YENİ ŞİFRE TEKRAR *@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Şifre (Tekrar)</label>
                            <input type="password" name="confirmPassword" class="form-control" placeholder="Yeni şifreyi onaylayın" required />
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="fas fa-save me-2"></i>Bilgileri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center">
                    <small class="text-danger">
                        <i class="fas fa-info-circle me-1"></i> Not: Bilgilerinizi değiştirdikten sonra sistem güvenliğiniz için sizi otomatik olarak çıkışa yönlendirecektir.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>