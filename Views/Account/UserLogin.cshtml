@model LoginViewModel
@{
    ViewData["Title"] = "Müşteri Girişi";
    Layout = null; // Layout'u kapatıyoruz ki temiz bir tam ekran olsun
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-page">

    <div class="auth-card">
        <div class="auth-header text-center mb-4">
            <img src="/img/logo.png" alt="TorosSolar" style="max-height: 50px;" class="mb-3">
            <h2>Hoş Geldiniz</h2>
            <p>Sürdürülebilir enerjiye giriş yapın</p>
        </div>

        <form asp-action="UserLogin" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="text-white-50 small mb-1">Kullanıcı Adı veya E-posta</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0 text-white-50"><i class="bi bi-person"></i></span>
                    <input asp-for="Username" class="form-control premium-input" placeholder="admin" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="text-white-50 small mb-1">Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0 text-white-50"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control premium-input" placeholder="••••••••" required />
                </div>
                <div class="text-end mt-1">
                    <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#resetPasswordModal" class="text-warning text-decoration-none small">Şifremi Unuttum?</a>
                </div>
            </div>

            <div class="security-box">
                <span class="small d-block text-white-50 mb-1">GÜVENLİK DOĞRULAMASI</span>
                @Model.Number1 + @Model.Number2 = ?
                <input asp-for="SecurityAnswer" class="form-control premium-input mt-2 text-center" placeholder="Sonucu buraya yazın" required />
                <input type="hidden" asp-for="Number1" />
                <input type="hidden" asp-for="Number2" />
            </div>

            <button type="submit" class="btn btn-premium w-100 mb-3">GİRİŞ YAP</button>

            <div class="text-center">
                <p class="text-white-50 small">Henüz hesabınız yok mu? <a asp-action="Register" class="text-warning fw-bold text-decoration-none">Kayıt Talebi Gönder</a></p>
            </div>
        </form>
    </div>

    @await Html.PartialAsync("_ResetPasswordModal")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>