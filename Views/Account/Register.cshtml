@model RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-page">

    <div class="auth-card" style="max-width: 600px;">
        <div class="auth-header text-center mb-4">
            <h2>Kayıt Talebi</h2>
            <p>TorosSolar ailesine katılmak için formu doldurun</p>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post">
            @* Hataları görmek için bu satırı ekledim *@
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="text-white-50 small mb-1">Ad Soyad</label>
                    <input asp-for="FullName" class="form-control premium-input" placeholder="İbrahim Özkan" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="text-white-50 small mb-1">E-posta</label>
                    <input asp-for="Email" class="form-control premium-input" placeholder="ornek@mail.com" />
                </div>
                <div class="col-md-12 mb-3">
                    <label class="text-white-50 small mb-1">Kullanıcı Adı</label>
                    <input asp-for="Username" class="form-control premium-input" placeholder="ibrahimözkan" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="text-white-50 small mb-1">Şifre</label>
                    <input asp-for="Password" type="password" class="form-control premium-input" placeholder="••••••••" />
                </div>
                <div class="col-md-6 mb-4">
                    <label class="text-white-50 small mb-1">Şifre Tekrar</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control premium-input" placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" class="btn btn-premium w-100 mb-3">KAYIT OL</button>

            <div class="text-center">
                <a asp-action="UserLogin" class="text-white-50 small text-decoration-none"><i class="bi bi-arrow-left"></i> Giriş Sayfasına Dön</a>
            </div>
        </form>
    </div>

</body>
</html>