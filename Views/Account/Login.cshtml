@model TorosSolar.Models.LoginViewModel
@{
    Layout = null; // Admin şablonunu burada kullanmıyoruz, sade olacak.
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Admin Girişi - TorosSolar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { background: #2c3e50; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: white; padding: 40px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); width: 100%; max-width: 400px; }
        .btn-login { background: #3498db; color: white; width: 100%; font-weight: bold; }
    </style>
</head>
<body>

<div class="login-card">
    <h3 class="text-center mb-4">Admin Paneli</h3>
    
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <input type="hidden" asp-for="Number1" />
        <input type="hidden" asp-for="Number2" />

        <div class="mb-3">
            <label class="form-label">Kullanıcı Adı</label>
            <input asp-for="Username" class="form-control" placeholder="admin" />
        </div>

        <div class="mb-3">
            <label class="form-label">Şifre</label>
            <input asp-for="Password" class="form-control" type="password" />
        </div>

        <div class="mb-3 p-3 bg-light border rounded text-center">
            <label class="form-label d-block fw-bold text-primary">Güvenlik Sorusu</label>
            <span class="fs-5">@Model.Number1 + @Model.Number2 = ?</span>
            <input asp-for="SecurityAnswer" class="form-control mt-2 text-center" placeholder="Sonucu yazın" required />
        </div>

        <button type="submit" class="btn btn-login py-2">Giriş Yap</button>
    </form>
</div>

</body>
</html>