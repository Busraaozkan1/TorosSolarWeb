<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1.5rem; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
            
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold" id="resetPasswordModalLabel">Şifremi Unuttum</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-shield-lock-fill text-warning" style="font-size: 3.5rem;"></i>
                </div>
                
                <p class="text-white-50 small mb-4">
                    Kayıtlı e-posta adresinizi girin, size şifre sıfırlama talimatlarını gönderelim.
                </p>
                
                <div class="mb-3 text-start">
                    <label class="text-white-50 small ms-2 mb-1">E-posta Adresi</label>
                    <input type="email" id="resetEmail" class="form-control" 
                           style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.2); color: white; border-radius: 0.75rem; padding: 0.8rem;" 
                           placeholder="ornek@torossolar.com">
                </div>
                
                <button type="button" class="btn w-100 text-white fw-bold mt-2" 
                        style="background: linear-gradient(90deg, #f97316 0%, #ea580c 100%); border: none; border-radius: 0.75rem; padding: 0.8rem;"
                        onclick="sendResetRequest()">
                    TALEP GÖNDER
                </button>
            </div>
            
            <div class="modal-footer border-0 justify-content-center pb-4 pt-0">
                <button type="button" class="btn btn-link text-white-50 text-decoration-none small" data-bs-dismiss="modal">
                    Vazgeç ve Giriş Ekranına Dön
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Razor hatasını engellemek için fonksiyonu bu şekilde tanımlıyoruz
    var sendResetRequest = function() {
        var emailInput = document.getElementById('resetEmail');
        var email = emailInput ? emailInput.value : "";
        
        // indexOf içindeki karakteri doğrudan yazmıyoruz
        if (email && email.indexOf(String.fromCharCode(64)) !== -1) {
            alert("Sıfırlama bağlantısı gönderildi: " + email);
            var modalElement = document.getElementById('resetPasswordModal');
            var modalInstance = bootstrap.Modal.getInstance(modalElement);
            if (modalInstance) modalInstance.hide();
        } else {
            alert("Lütfen geçerli bir e-posta adresi giriniz.");
        }
    };
</script>