<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TorosSolar</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg custom-nav fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                TOROS<span style="color:rgb(59, 59, 59)">SOLAR</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" href="/#anasayfa">Anasayfa</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#hakkimizda">Hakkımızda</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#hizmetlerimiz">Hizmetlerimiz</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#urunlerimiz">Ürünlerimiz</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#iletisim">İletişim</a></li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @* Admin Paneli butonu buradan kaldırıldı *@

                        <li class="nav-item">
                            <a class="nav-link btn btn-sm btn-outline-warning ms-lg-3 px-3 me-2" 
                               style="border-radius: 20px;" 
                               asp-controller="Account" 
                               asp-action="Profile">
                                 <i class="bi bi-person-circle"></i> Profilim
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-sm btn-outline-danger px-3" 
                               style="border-radius: 20px;" 
                               asp-controller="Account" 
                               asp-action="Logout">Çıkış Yap</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn btn-sm btn-outline-light ms-lg-3 px-3" 
                               style="border-radius: 20px;" 
                               asp-controller="Account" 
                               asp-action="UserLogin">Giriş Yap / Kayıt Ol</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<footer class="footer text-center py-5">
    <div class="container">
        <div class="mb-3">
            <h4 style="color:var(--gold); font-weight: 800; letter-spacing: 2px;">TOROSSOLAR</h4>
        </div>
        <div class="mb-3 text-white-50">
            <small>Mersin'den Dünyaya Sürdürülebilir Enerji</small>
        </div>
        <div class="mt-2">
            <span class="text-white-50 small">&copy; 2026 - Geleceğin Enerjisi - Tüm Hakları Saklıdır.</span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>